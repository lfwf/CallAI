{
  "name": "ai-activity-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "events:validate": "node scripts/prepare-events.mjs --check",
    "events:check-links": "node scripts/prepare-events.mjs --check-links",
    "events:prepare": "node scripts/prepare-events.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "build": "node scripts/prepare-events.mjs --check-links && node scripts/prepare-events.mjs && vinext build && node scripts/copy-hosting.mjs",
    "start": "vinext start"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@vitejs/plugin-rsc": "^0.5.32",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.0"
  }
}
